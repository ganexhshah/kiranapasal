APP_NAME="KRM Retail System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE="Asia/Kathmandu"
APP_URL=https://api.krmapp.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,sentry
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# PostgreSQL Configuration
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT: 5432
DB_DATABASE=krm_db
DB_USERNAME=krm_user
DB_PASSWORD=krm_secret_password

# Session & Cache (Redis)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=r2
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=krm_cache_

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Laravel Reverb (WebSockets)
REVERB_APP_ID=krm-app-id
REVERB_APP_KEY=krm-app-key-reverb-secret
REVERB_APP_SECRET=krm-app-secret-reverb-auth
REVERB_HOST="0.0.0.0"
REVERB_PORT=8080
REVERB_SCHEME=http

# Cloudflare R2 (S3 Compatible Storage)
CLOUDFLARE_R2_ACCOUNT_ID=516d4d7c8a274b7f897979999bcb096b
CLOUDFLARE_R2_ACCESS_KEY_ID=80077dcf329a6b01c33e2c44b2b31e9b
CLOUDFLARE_R2_SECRET_ACCESS_KEY=506cbfc47728c0c24cb2756620e9936fcddd35f0ed9c633102454c6ddb86f2b4
CLOUDFLARE_R2_BUCKET=protofilo
CLOUDFLARE_R2_ENDPOINT=https://516d4d7c8a274b7f897979999bcb096b.r2.cloudflarestorage.com
CLOUDFLARE_R2_URL=https://ganeshshah.com
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=true

# Firebase Authentication
FIREBASE_PROJECT_ID=krm-pos-auth
FIREBASE_CREDENTIALS=/var/www/html/storage/app/firebase-credentials.json

# Sentry Error Tracking
SENTRY_LARAVEL_DSN=https://your-sentry-dsn@o123456.ingest.sentry.io/7891011
SENTRY_TRACES_SAMPLE_RATE=0.2

# Ports for Docker Compose
HTTP_PORT=80
HTTPS_PORT=443
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379

